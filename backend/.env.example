# 이 파일을 .env 로 복사한 뒤 값을 채운다.  (.env 는 .gitignore 에 있어 GitHub에 올라가지 않는다)
#   Windows:  copy .env.example .env

# ── Claude (기본) ───────────────────────────
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# ── OpenAI (예비: 교수님이 임시 키를 준 경우에만) ──
# LLM_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_MODEL=

# LLM_PROVIDER 를 적지 않으면: ANTHROPIC_API_KEY 가 있으면 Claude, 없으면 OpenAI 를 쓴다.

# 선택
# PORT=5000
# DEBUG=1
# MIRRORME_DB=skincare.db
